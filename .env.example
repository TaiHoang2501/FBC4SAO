OLLAMA_URL=http://localhost:11434/api/chat
# Model chuẩn dùng trong thực nghiệm: qwen2.5:7b-instruct-q4_K_M
# Model nhẹ cho CPU smoke test: qwen3.5:0.8b
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
ENABLE_DYNAMIC_WEB_SEARCH=1
ENABLE_QUERY_REWRITING=1
ENABLE_SEMANTIC_CACHE=1
CACHE_THRESHOLD=0.92

# Tavily Web Search (lấy tại https://app.tavily.com)
TAVILY_API_KEY=tvly-your-api-key-here

# OpenAI (tùy chọn, không dùng trong luồng chính)
# OPENAI_API_KEY=sk-proj-...
